{
    "lines": [
        { "index": 1, "start": 0.0, "en": "Hello, Yakka Dee!", "zh": "你好，亚克迪！" },
        { "index": 2, "start": 4.2, "en": "Today's word is... BIKE!", "zh": "今天的单词是……自行车！" },
        { "index": 3, "start": 8.5, "en": "Bike! Bike! Bike!", "zh": "自行车！自行车！自行车！" },
        { "index": 4, "start": 12.0, "en": "I love my bike. It goes wheeeee!", "zh": "我爱我的自行车。它嗖嗖跑！" },
        { "index": 5, "start": 16.8, "en": "Look at me! I can ride my bike.", "zh": "看我！我会骑自行车。" },
        { "index": 6, "start": 21.5, "en": "Ring the bell! Ding ding!", "zh": "按铃！叮叮！" },
        { "index": 7, "start": 26.0, "en": "Fast bike! Slow bike! Big bike! Small bike!", "zh": "快自行车！慢自行车！大自行车！小自行车！" },
        { "index": 8, "start": 30.5, "en": "A bike with three wheels! A tricycle!", "zh": "三个轮子的自行车！三轮车！" },
        { "index": 9, "start": 35.0, "en": "Helmet on! Safety first!", "zh": "戴上头盔！安全第一！" },
        { "index": 10, "start": 39.5, "en": "Pedal, pedal, pedal! I'm going so fast!", "zh": "踩踏板，踩，踩！我骑得好快！" },
        { "index": 11, "start": 44.0, "en": "Brakes on! Stop! Phew!", "zh": "刹车！停！呼！" },
        { "index": 12, "start": 48.5, "en": "Say it again! Bike!", "zh": "再说一次！自行车！" },
        { "index": 13, "start": 52.0, "en": "Bike! Bike! Bike! Well done!", "zh": "自行车！自行车！自行车！做得好！" },
        { "index": 14, "start": 56.0, "en": "See you next time on Yakka Dee!", "zh": "下次亚克迪见！" }
    ]
}