{
  "lines": [
    { "index": 1, "start": "00:00", "en": "The Frightened Lion (", "zh": "受惊的狮子（" },
    { "index": 2, "start": "00:04", "en": "One night, Lion is getting ready for bed.", "zh": "一天晚上，狮子正准备睡觉。" },
    { "index": 3, "start": "00:09", "en": "He reads his favorite bedtime story and sings his favorite bedtime song.", "zh": "他读了最喜欢的睡前故事，唱了最喜欢的睡前歌。" },
    { "index": 4, "start": "00:15", "en": "He turns on his night-light.", "zh": "他打开了小夜灯。" },
    { "index": 5, "start": "00:18", "en": "Then — he hears a sound...", "zh": "然后——他听见了一个声音……" },
    { "index": 6, "start": "00:23", "en": "Tap!", "zh": "嗒！" },
    { "index": 7, "start": "00:25", "en": "… Tap!", "zh": "……嗒！" },
    { "index": 8, "start": "00:27", "en": "\"What’s that sound?", "zh": "“那是什么声音？" },
    { "index": 9, "start": "00:30", "en": "” he whispers.", "zh": "”他小声说。" },
    { "index": 10, "start": "00:33", "en": "Tap!", "zh": "嗒！" },
    { "index": 11, "start": "00:35", "en": "… Tap!", "zh": "……嗒！" },
    { "index": 12, "start": "00:37", "en": "\"That sound… it’s coming from outside the window!", "zh": "“那个声音……是从窗外传来的！" },
    { "index": 13, "start": "00:42", "en": "” He climbs out of bed.", "zh": "”他爬下床。" },
    { "index": 14, "start": "00:45", "en": "He grabs a baseball bat and tip-toes towards the window.", "zh": "他抓起一根棒球棒，踮着脚朝窗户走去。" },
    { "index": 15, "start": "00:51", "en": "Tap!", "zh": "嗒！" },
    { "index": 16, "start": "00:53", "en": "Tap!", "zh": "嗒！" },
    { "index": 17, "start": "00:55", "en": "Tappity-tap!", "zh": "嗒嗒嗒！" },
    { "index": 18, "start": "00:57", "en": "TAP!", "zh": "嗒！" },
    { "index": 19, "start": "01:00", "en": "“It’s a monster!", "zh": "“是怪物！" },
    { "index": 20, "start": "01:02", "en": "” he thinks.", "zh": "”他想。" },
    { "index": 21, "start": "01:04", "en": "He grabs his bicycle helmet and puts it on his head for protection.", "zh": "他抓起自行车头盔戴上，好保护自己。" },
    { "index": 22, "start": "01:10", "en": "He hears the sound again...", "zh": "他又听见了那个声音……" },
    { "index": 23, "start": "01:14", "en": "TAP!", "zh": "嗒！" },
    { "index": 24, "start": "01:16", "en": "...", "zh": "……" },
    { "index": 25, "start": "01:18", "en": "TAP!", "zh": "嗒！" },
    { "index": 26, "start": "01:20", "en": "… Tappity-TAP!", "zh": "……嗒嗒—嗒！" },
    { "index": 27, "start": "01:23", "en": "Lion panics.", "zh": "狮子慌了。" },
    { "index": 28, "start": "01:26", "en": "“The monster is getting closer!", "zh": "“怪物越来越近了！" },
    { "index": 29, "start": "01:29", "en": "It sounds like the BIGGEST, SCARIEST monster ever!", "zh": "听起来是从未有过的最大、最可怕的怪物！" },
    { "index": 30, "start": "01:35", "en": "” Tap!", "zh": "”嗒！" },
    { "index": 31, "start": "01:37", "en": "...", "zh": "……" },
    { "index": 32, "start": "01:39", "en": "Tap!", "zh": "嗒！" },
    { "index": 33, "start": "01:41", "en": "...", "zh": "……" },
    { "index": 34, "start": "01:43", "en": "Tappity-tap!", "zh": "嗒嗒嗒！" },
    { "index": 35, "start": "01:45", "en": "TAPPITY-TAP!", "zh": "嗒嗒—嗒！" },
    { "index": 36, "start": "01:48", "en": "TAPPITY-TAPPITY-TAPPITY….", "zh": "嗒嗒嗒—嗒嗒嗒—嗒嗒嗒……" },
    { "index": 37, "start": "01:53", "en": "TAP!", "zh": "嗒！" },
    { "index": 38, "start": "01:56", "en": "\"EEEK!\"", "zh": "“呀——！”" },
    { "index": 39, "start": "01:58", "en": "Lion squeals.", "zh": "狮子尖叫起来。" },
    { "index": 40, "start": "02:00", "en": "He runs away from the window and hides under the bed.", "zh": "他从窗边跑开，躲到了床底下。" },
    { "index": 41, "start": "02:05", "en": "He pulls a blanket over his head.", "zh": "他用毯子把头蒙住。" },
    { "index": 42, "start": "02:08", "en": "He holds his baseball bat tightly in his hands, and….", "zh": "他双手紧紧握着棒球棒，然后……" },
    { "index": 43, "start": "02:13", "en": "Tappity tap!", "zh": "嗒嗒嗒！" },
    { "index": 44, "start": "02:15", "en": "A little frog jumps up on the window sill.", "zh": "一只小青蛙跳上了窗台。" },
    { "index": 45, "start": "02:19", "en": "The frog is wearing a tutu and tap shoes.", "zh": "青蛙穿着芭蕾短裙和踢踏舞鞋。" },
    { "index": 46, "start": "02:24", "en": "She dances a little dance.", "zh": "她跳了一小段舞。" },
    { "index": 47, "start": "02:28", "en": "Tap tap tappity tap!", "zh": "嗒、嗒、嗒嗒嗒、嗒！" },
    { "index": 48, "start": "02:32", "en": "\"Hello Lion!", "zh": "“你好呀，狮子！" },
    { "index": 49, "start": "02:34", "en": "Are you in there?", "zh": "你在里面吗？" },
    { "index": 50, "start": "02:36", "en": "” says the frog.", "zh": "”青蛙说。" },
    { "index": 51, "start": "02:39", "en": "She looks through the window and sees Lion hiding under the bed.", "zh": "她透过窗户看见狮子躲在床底下。" },
    { "index": 52, "start": "02:45", "en": "Lion is wrapped in a blanket… wearing a bicycle helmet … ...", "zh": "狮子裹着毯子……戴着自行车头盔……" },
    { "index": 53, "start": "02:51", "en": "and holding a baseball bat.", "zh": "还举着一根棒球棒。" },
    { "index": 54, "start": "02:54", "en": "He looks ridiculous.", "zh": "他看上去滑稽极了。" },
    { "index": 55, "start": "02:57", "en": "(And to be honest, he feels ridiculous too.)", "zh": "（说实话，他自己也觉得挺滑稽的。）" },
    { "index": 56, "start": "03:01", "en": "\"Ummm… I have some new dance moves to show you,\" says the frog.", "zh": "“嗯……我学了几个新舞步想跳给你看，”青蛙说。" },
    { "index": 57, "start": "03:07", "en": "\"But you look busy.", "zh": "“不过你看起来挺忙的。" },
    { "index": 58, "start": "03:10", "en": "I will come back later.", "zh": "我晚点再来吧。" },
    { "index": 59, "start": "03:12", "en": "See ya!\"", "zh": "回头见！”" },
    { "index": 60, "start": "03:14", "en": "The frog hops down to the ground and happily dances away.", "zh": "青蛙跳到地上，欢快地一路跳着舞走了。" },
    { "index": 61, "start": "03:20", "en": "Tap-TAP!", "zh": "嗒—嗒！" },
    { "index": 62, "start": "03:23", "en": "Tappity-tappity-TAP!", "zh": "嗒嗒嗒—嗒嗒嗒—嗒！" },
    { "index": 63, "start": "03:26", "en": "Moral: Sometimes our imaginations make things scarier than they really are.", "zh": "寓意：有时候是我们的想象把事情弄得比实际可怕。" }
  ]
}
