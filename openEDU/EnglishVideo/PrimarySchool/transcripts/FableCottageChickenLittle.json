      "en": "” asks Chuck.",
      "zh": "”查克问。"
    },
    {
      "index": 54,
      "start": "02:22",
      "en": "“I saw it on the internet!",
      "zh": "“我在网上看到的！"
    },
    {
      "index": 55,
      "start": "02:24",
      "en": "” says Chicken Little.",
      "zh": "”小鸡快跑说。"
    },
    {
      "index": 56,
      "start": "02:26",
      "en": "“Oh no!",
      "zh": "“不好了！"
    },
    {
      "index": 57,
