{
    "lines": [
        { "index": 1, "start": 0.0, "en": "Hello, I'm Maisy.", "zh": "你好，我是梅西。" },
        { "index": 2, "start": 4.5, "en": "Today I'm going to the park.", "zh": "今天我要去公园。" },
        { "index": 3, "start": 9.0, "en": "Put on my coat. Where are my shoes?", "zh": "穿上外套。我的鞋呢？" },
        { "index": 4, "start": 15.0, "en": "Here they are! Under the chair.", "zh": "在这儿！椅子底下。" },
        { "index": 5, "start": 20.5, "en": "Let's go! Open the door.", "zh": "走吧！开门。" },
        { "index": 6, "start": 25.0, "en": "Hello, Cyril! Hello, Charley!", "zh": "你好，西里尔！你好，查理！" },
        { "index": 7, "start": 30.0, "en": "Let's play on the slide!", "zh": "我们去滑梯上玩吧！" },
        { "index": 8, "start": 34.5, "en": "Wheee! That was fun!", "zh": "呼！真好玩！" },
        { "index": 9, "start": 39.0, "en": "Now the swing. Push me, Charley!", "zh": "现在荡秋千。查理，推我！" },
        { "index": 10, "start": 44.5, "en": "Higher! Higher! So high!", "zh": "再高一点！再高一点！好高！" },
        { "index": 11, "start": 50.0, "en": "Time to go home. Bye, friends!", "zh": "该回家了。再见，朋友们！" }
    ]
}