        {"name": "你吃饱了吗", "en": "Are you full?", "lessonUrl": "are-you-full.jpg"},
        {"name": "你吃完了呀", "en": "You're all done.", "lessonUrl": "youre-all-done.jpg"},
        {"name": "用纸巾擦一下鼻子", "en": "Wipe your nose.", "lessonUrl": "wipe-your-nose.jpg"},
