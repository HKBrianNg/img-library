  "chapters": [
    {
      "name":"第一章：在家门口",
      "en": "Chapter 1: At the Door",
      "items": [
        {"name": "先换拖鞋", "en": "Change into your slippers first.", "lessonUrl": "change-into-your-slippers-first.jpg"},
        {"name": "先把鞋脱了", "en": "Take off your shoes first.", "lessonUrl": "take-off-your-shoes-first.jpg"},
        {"name": "拍拍鞋子上的泥", "en": "Dust the mud off your shoes.", "lessonUrl": "dust-the-mud-off-your-shoes.jpg"},
        {"name": "把鞋子摆整齐", "en": "Make your shoes nice and neat.", "lessonUrl": "make-your-shoes-nice-and-neat.jpg"},
        {"name": "你的鞋在鞋柜里", "en": "Your shoes are in the shoe cabinet.", "lessonUrl": "your-shoes-are-in-the-shoe-cabinet.jpg"},
        {"name": "打开鞋柜把鞋拿出来", "en": "Open the shoe cabinet and take out your shoes.", "lessonUrl": "open-the-shoe-cabinet-and-take-out-your-shoes.jpg"},
        {"name": "坐下来换鞋", "en": "Sit down to change your shoes.", "lessonUrl": "sit-down-to-change-your-shoes.jpg"},
        {"name": "快点穿上鞋", "en": "Put your shoes on.", "lessonUrl": "put-your-shoes-on.jpg"},
        {"name": "你要迟到了", "en": "You're going to be late.", "lessonUrl": "youre-going-to-be-late.jpg"},
        {"name": "你的鞋带松了", "en": "Your shoes are untied.", "lessonUrl": "your-shoes-are-untied.jpg"},
        {"name": "把鞋带系好", "en": "Tie your shoelaces.", "lessonUrl": "tie-your-shoelaces.jpg"},
        {"name": "你东西都拿好了吗", "en": "Did you get everything?", "lessonUrl": "did-you-get-everything.jpg"},
        {"name": "你的书包收拾好了吗", "en": "Is your bag ready to go?", "lessonUrl": "is-your-bag-ready-to-go.jpg"},
        {"name": "书都放进去了吗", "en": "Are your books all packed?", "lessonUrl": "are-your-books-all-packed.jpg"},
        {"name": "确认一下东西都带齐了哦", "en": "Make sure you have everything.", "lessonUrl": "make-sure-you-have-everything.jpg"},
        {"name": "水杯带了吗", "en": "Do you have your water bottle?", "lessonUrl": "do-you-have-your-water-bottle.jpg"},
        {"name": "自己背书包", "en": "Carry your own bag.", "lessonUrl": "carry-your-own-bag.jpg"},
        {"name": "妈妈要锁门了", "en": "Mom is going to lock the door.", "lessonUrl": "mom-is-going-to-lock-the-door.jpg"},
        {"name": "小心夹到手", "en": "Watch your fingers.", "lessonUrl": "watch-your-fingers.jpg"},
        {"name": "记得关灯", "en": "Remember to turn off the lights.", "lessonUrl": "remember-to-turn-off-the-lights.jpg"},
        {"name": "快点爸爸在电梯那等你呢", "en": "Come on, dad's waiting for you by the elevator.", "lessonUrl": "come-on-dads-waiting-for-you-by-the-elevator.jpg"},
        {"name": "走去上学啦", "en": "Let's go to school.", "lessonUrl": "lets-go-to-school.jpg"},
        {"name": "爸爸要上班啦", "en": "Dad has to go to work.", "lessonUrl": "dad-has-to-go-to-work.jpg"},
        {"name": "妈妈出门啦", "en": "Mom's heading out.", "lessonUrl": "moms-heading-out.jpg"},
        {"name": "跟妈妈说拜拜", "en": "Say goodbye to mom.", "lessonUrl": "say-goodbye-to-mom.jpg"},
        {"name": "爸爸回来我们一起玩游戏", "en": "We'll play a game when dad comes back.", "lessonUrl": "well-play-a-game-when-dad-comes-back.jpg"},
        {"name": "爸爸上完班很快就会回来的", "en": "Dad will be back soon after work.", "lessonUrl": "dad-will-be-back-soon-after-work.jpg"},
        {"name": "给妈妈一个飞吻", "en": "Blow a kiss to mom.", "lessonUrl": "blow-a-kiss-to-mom.jpg"},
        {"name": "快过来抱抱", "en": "Come and give me a hug.", "lessonUrl": "come-and-give-me-a-hug.jpg"},
        {"name": "我会想你的宝贝", "en": "I'm going to miss you, baby.", "lessonUrl": "im-going-to-miss-you-baby.jpg"},
        {"name": "要听外婆奶奶的话噢", "en": "Mind your grandmother.", "lessonUrl": "mind-your-grandmother.jpg"},
        {"name": "在家去上学要乖乖噢", "en": "Be good at home/ school.", "lessonUrl": "be-good-at-home-school.jpg"},
        {"name": "按一楼负一楼", "en": "Press the 1st floor/ B1 button.", "lessonUrl": "press-the-1st-floor-b1-button.jpg"},
        {"name": "我回来啦", "en": "I'm back.", "lessonUrl": "im-back.jpg"},
        {"name": "把书包放好", "en": "Put your bag away.", "lessonUrl": "put-your-bag-away.jpg"},
        {"name": "今天有没有乖乖听话呀", "en": "Were you good today?", "lessonUrl": "were-you-good-today.jpg"},
        {"name": "今天过得怎么样", "en": "How was your day?", "lessonUrl": "how-was-your-day.jpg"},
        {"name": "今天老师有没有表扬你呀", "en": "Did the teacher praise you today?", "lessonUrl": "did-the-teacher-praise-you-today.jpg"},
        {"name": "跟妈妈一起去取快递吧", "en": "Come with mom to pick up our package.", "lessonUrl": "come-with-mom-to-pick-up-our-package.jpg"},
        {"name": "走出去玩啦", "en": "Let's go outside to play.", "lessonUrl": "lets-go-outside-to-play.jpg"},
        {"name": "带你喜欢的小零食吧", "en": "Bring some of your favorite snacks.", "lessonUrl": "bring-some-of-your-favorite-snacks.jpg"},
        {"name": "涂一点防晒霜", "en": "Let's put on a little sunscreen.", "lessonUrl": "lets-put-on-a-little-sunscreen.jpg"},
        {"name": "你需要戴上防晒帽", "en": "You'll need your sun hat.", "lessonUrl": "youll-need-your-sun-hat.jpg"},
        {"name": "骑上你的滑板车吧", "en": "Ride your little scooter.", "lessonUrl": "ride-your-little-scooter.jpg"},
        {"name": "骑上你的扭扭车吧", "en": "Ride your wiggle car.", "lessonUrl": "ride-your-wiggle-car.jpg"},
        {"name": "戴上护膝", "en": "Put on your pads.", "lessonUrl": "put-on-your-pads.jpg"}
      ]
    },
    {
      "name": "第二章：在客厅",
      "en": "Chapter 2: In the Living Room",
      "items": [
        {"name": "不要撞到茶几了", "en": "Don't bump into the table.", "lessonUrl": "dont-bump-into-the-table.jpg"},
        {"name": "别坐在地上地上又脏又凉", "en": "Don't sit on the floor. It's dirty and cold.", "lessonUrl": "dont-sit-on-the-floor-its-dirty-and-cold.jpg"},
        {"name": "别把杯子放在桌子边上", "en": "Don't put your cup on the edge.", "lessonUrl": "dont-put-your-cup-on-the-edge.jpg"},
        {"name": "不要把手指插进插座里", "en": "Don't stick your finger in the socket.", "lessonUrl": "dont-stick-your-finger-in-the-socket.jpg"},
        {"name": "你会被电到的", "en": "It will shock you.", "lessonUrl": "it-will-shock-you.jpg"},
        {"name": "不要在沙发上乱跳", "en": "Don't jump around on the sofa.", "lessonUrl": "dont-jump-around-on-the-sofa.jpg"},
        {"name": "别把脚搭在茶几上", "en": "Don't put your feet on the table.", "lessonUrl": "dont-put-your-feet-on-the-table.jpg"},
        {"name": "别躺在地上不然你会感冒的", "en": "Don't lie on the floor or you'll catch a cold.", "lessonUrl": "dont-lie-on-the-floor-or-youll-catch-a-cold.jpg"},
        {"name": "不要对着空调吹", "en": "Don't stand in front of the AC.", "lessonUrl": "dont-stand-in-front-of-the-ac.jpg"},
        {"name": "把空调关了吧", "en": "Turn the AC off.", "lessonUrl": "turn-the-ac-off.jpg"},
        {"name": "躺在沙发上休息一下吧", "en": "Lie down on the sofa and have a rest.", "lessonUrl": "lie-down-on-the-sofa-and-have-a-rest.jpg"},
        {"name": "你只能看20分钟哦", "en": "You can only watch for 20 minutes.", "lessonUrl": "you-can-only-watch-for-20-minutes.jpg"},
        {"name": "到时间就关喽", "en": "Turn it off when the time's up.", "lessonUrl": "turn-it-off-when-the-times-up.jpg"},
        {"name": "你知道遥控器在哪吗", "en": "Do you know where the remote is?", "lessonUrl": "do-you-know-where-the-remote-is.jpg"},
        {"name": "把遥控器递给我", "en": "Hand me the remote.", "lessonUrl": "hand-me-the-remote.jpg"},
        {"name": "我手机没电了", "en": "My phone is out of power.", "lessonUrl": "my-phone-is-out-of-power.jpg"},
        {"name": "它得充会儿电", "en": "It needs to be charged.", "lessonUrl": "it-needs-to-be-charged.jpg"},
        {"name": "请拿给我", "en": "Get it for me, please.", "lessonUrl": "get-it-for-me-please.jpg"},
        {"name": "说请", "en": "What's the magic word?", "lessonUrl": "whats-the-magic-word.jpg"},
        {"name": "不用谢", "en": "You're welcome.", "lessonUrl": "youre-welcome.jpg"},
        {"name": "不要在客厅拍球", "en": "Don't bounce the ball in the living room.", "lessonUrl": "dont-bounce-the-ball-in-the-living-room.jpg"},
        {"name": "轻点不要在地板上跳", "en": "Don't pound on the floor.", "lessonUrl": "dont-pound-on-the-floor.jpg"},
        {"name": "不要大吼大叫", "en": "Don't shout.", "lessonUrl": "dont-shout.jpg"},
        {"name": "噪音太大会影响楼下邻居", "en": "You'll disturb the downstairs neighbors.", "lessonUrl": "youll-disturb-the-downstairs-neighbors.jpg"},
        {"name": "不要在墙上乱涂乱画", "en": "Don't scribble on the wall.", "lessonUrl": "dont-scribble-on-the-wall.jpg"},
        {"name": "把垃圾扔到垃圾桶里", "en": "Throw your trash in the trash.", "lessonUrl": "throw-your-trash-in-the-trash.jpg"}
      ]
    },
    {
      "name": "第三章：在阳台",
      "en": "Chapter 3: On the Balcony",
      "items": [
        {"name": "帮妈妈收一下垃圾", "en": "Help mom get the trash, please.", "lessonUrl": "help-mom-get-the-trash-please.jpg"},
