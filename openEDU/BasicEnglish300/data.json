        {"name": "快点把食物咽下去", "en": "Swallow your food.", "lessonUrl": "swallow-your-food.jpg"},
        {"name": "你吃得太少了", "en": "You didn't eat enough.", "lessonUrl": "you-didnt-eat-enough.jpg"},
        {"name": "别吃撑了", "en": "Don't stuff yourself.", "lessonUrl": "dont-stuff-yourself.jpg"},
        {"name": "不要弄得到处都是", "en": "Don't mess around.", "lessonUrl": "dont-mess-around.jpg"},
        {"name": "不要浪费食物", "en": "Don't waste your food.", "lessonUrl": "dont-waste-your-food.jpg"},
